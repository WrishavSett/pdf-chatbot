# Dockerfile.frontend
# --------------------
# Serves the static HTML/CSS/JS frontend via nginx.
# The API (api.py) runs separately and is already CORS-enabled (flask-cors).
# This container only serves static files — zero Python, zero modifications
# to the backend or middleware.

FROM nginx:alpine

# Copy static frontend files into nginx's default web root
COPY frontend/ /usr/share/nginx/html/

# Expose port 80 (mapped to host port 3000 in docker-compose)
EXPOSE 80
